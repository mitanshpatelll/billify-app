# Public values only: everything starting with EXPO_PUBLIC_ is bundled into the app.
# On a real phone, use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Where customers open shared bills (/b/[token], the web build of this app).
# Local: the Expo web dev server. Production: the EAS Hosting URL.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
